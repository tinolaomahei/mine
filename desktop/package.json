{
  "name": "mine-desktop",
  "productName": "mine",
  "version": "0.1.0",
  "private": true,
  "description": "mine: a desktop AI harness that starts with nothing and learns how you work.",
  "homepage": "https://mine.computer",
  "author": "tinolaomahei",
  "repository": {
    "type": "git",
